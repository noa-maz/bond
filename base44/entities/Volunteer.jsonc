{
  "name": "Volunteer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "neighborhood": {
      "type": "string",
      "title": "Neighborhood"
    },
    "offer_types": {
      "type": "array",
      "title": "What they can offer",
      "items": {
        "type": "string",
        "enum": [
          "Childcare",
          "Cooking",
          "Transportation",
          "Just being there"
        ]
      }
    },
    "frequency": {
      "type": "string",
      "title": "Availability Frequency",
      "enum": [
        "Once a week",
        "Twice a month",
        "Once a month",
        "Flexible - I'll coordinate with my circle"
      ]
    },
    "committed_family_id": {
      "type": "string",
      "title": "Committed Family ID"
    },
    "user_email": {
      "type": "string",
      "title": "User Email"
    }
  },
  "required": [
    "name",
    "neighborhood",
    "offer_types",
    "frequency"
  ]
}