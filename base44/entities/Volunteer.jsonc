{
  "name": "Volunteer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "neighborhood": {
      "type": "string",
      "title": "Neighborhood"
    },
    "phone": {
      "type": "string",
      "title": "Phone Number"
    },
    "offer_types": {
      "type": "array",
      "title": "What they can offer",
      "items": {
        "type": "string",
        "enum": [
          "Childcare",
          "Cooking",
          "Transportation",
          "Just being there"
        ]
      }
    },
    "frequency": {
      "type": "string",
      "title": "Availability Frequency",
      "enum": [
        "Once a week",
        "Twice a month",
        "Once a month",
        "Flexible - I'll coordinate with my circle"
      ]
    },
    "committed_family_ids": {
      "type": "array",
      "title": "Committed Family IDs",
      "items": {
        "type": "string"
      }
    },
    "approved_family_ids": {
      "type": "array",
      "title": "Approved Family IDs",
      "items": {
        "type": "string"
      }
    },
    "user_email": {
      "type": "string",
      "title": "User Email"
    }
  },
  "required": [
    "name",
    "neighborhood",
    "offer_types",
    "frequency"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}