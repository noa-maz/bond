{
  "name": "Family",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "neighborhood": {
      "type": "string",
      "title": "Neighborhood"
    },
    "phone": {
      "type": "string",
      "title": "Phone Number"
    },
    "number_of_children": {
      "type": "number",
      "title": "Number of Children"
    },
    "needs": {
      "type": "object",
      "title": "Needs"
    },
    "hardest_lately": {
      "type": "string",
      "title": "What's been hardest lately?"
    },
    "user_email": {
      "type": "string",
      "title": "User Email"
    },
    "paused": {
      "type": "boolean",
      "title": "Circle Paused"
    },
    "pause_reason": {
      "type": "string",
      "title": "Pause Reason"
    }
  },
  "required": [
    "name",
    "neighborhood",
    "number_of_children"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.paused": {
            "$ne": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}